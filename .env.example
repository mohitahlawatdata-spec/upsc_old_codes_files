# Copy to .env and fill in your own values. Never commit .env.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://mainsmaster:mainsmaster@127.0.0.1:5432/mainsmaster
GOOGLE_API_KEY=
OCR_MODEL=gemini-3.5-flash-lite
EVAL_MODEL=gemini-3.5-flash-lite
# CLEANUP_PROVIDER: gemini (default) or none
CLEANUP_PROVIDER=gemini
RESTRUCTURE_MODEL=gemini-3.5-flash-lite
MENTOR_PROVIDER=gemini
MENTOR_MODEL=gemini-3.5-flash-lite
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=384
# Durable production artifacts use `s3`; `local` is for development only.
ARTIFACT_STORE=local
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_CREATE_BUCKET=false
RETAIN_LOCAL_ARTIFACTS=true
# DATA_DIR=var/data
# POPPLER_PATH=C:\path\to\poppler\Library\bin
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=30
